<?xml version="1.0" encoding="utf-8"?>
<!-- Nota bul: projetsm.com yalnızca HTTP sunuyor; cleartext yalnızca bu alan adına açık, gerisi HTTPS -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">projetsm.com</domain>
    </domain-config>
</network-security-config>
